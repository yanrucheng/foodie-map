{
  "name": "foodie-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11 <12",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "check": "npm run check:types && npm run check:lint && npm run validate:data",
    "check:repository": "node scripts/check-repository.mjs",
    "check:dependencies": "npm audit --audit-level=high",
    "validate:data": "node scripts/data-contract.ts",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:lint": "eslint . --max-warnings 0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "browser:install": "puppeteer browsers install chrome-headless-shell && PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/playwright playwright install webkit",
    "test:e2e": "node scripts/e2e.mjs",
    "test:all": "npm test && npm run test:e2e",
    "readme": "python3 scripts/render-coverage-table.py",
    "test:performance": "node tests/e2e/performance.mjs",
    "release:check": "node scripts/release-quality.mjs check",
    "release:verify": "node scripts/release-quality.mjs verify",
    "release:smoke": "node scripts/release-smoke.ts",
    "release:snapshot": "node scripts/release-quality.mjs snapshot",
    "test:gates": "node tests/e2e/fault-injection.mjs",
    "check:coverage": "python3 scripts/render-coverage-table.py --check",
    "data:aliases": "node scripts/guide-operations.ts aliases",
    "data:diff": "node scripts/guide-operations.ts diff",
    "rehearse:catalog": "node tests/e2e/catalog-rehearsal.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "leaflet.markercluster": "1.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "playwright": "1.63.0",
    "puppeteer": "^25.11.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
